# Copiar a .env.local y completar con `vercel env pull .env.local` (recomendado)
# o con los valores reales del proyecto Neon. Nunca commitear .env.local.

# --- Base de datos (Neon Postgres) ---
# DATABASE_URL (rol neondb_owner, acceso completo) se usa SOLO para correr
# migraciones a mano — la app en runtime nunca se conecta con este rol.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Rol de mínimo privilegio (solo DML, sin DDL) — este es el que usa la app
# en runtime (ver lib/db.ts). RLS está habilitado en todas las tablas pero
# no es la defensa real (todo rol de Neon tiene BYPASSRLS); el filtro por
# tenant_id en cada query es la defensa real.
APP_DATABASE_URL=

# --- Neon Object Storage (fotos de activos, manuales PDF, informes) ---
# Neon los inyecta automáticamente en Vercel; en local, `vercel env pull`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# --- Neon Auth (Managed Better Auth) ---
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=

# --- IA (asistente RAG) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Vercel (se genera solo con `vercel env pull`, no hace falta tocarlo) ---
VERCEL_OIDC_TOKEN=
